# Copy to .env. Secrets (DB password, JWT key, encryption key, API key pepper) live in ./secrets, see scripts/init-secrets.sh.

# ---- Reverse proxy: choose ONE --------------------------------------------------
# Nginx Proxy Manager (default). Ultimyr joins the Docker network NPM is on.
COMPOSE_FILE=docker-compose.yml:docker-compose.npm.yml
PROXY_NETWORK=proxy
# Traefik instead (bundled, listens on ULTIMYR_HTTP_PORT):
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# ULTIMYR_HTTP_PORT=8080
# No proxy overlay at all: COMPOSE_FILE=docker-compose.yml  (web is published on ULTIMYR_BIND:ULTIMYR_WEB_PORT)

# Published ports for the web and auth containers (loopback by default)
ULTIMYR_BIND=127.0.0.1
ULTIMYR_WEB_PORT=3000
ULTIMYR_AUTH_PORT=4001
ULTIMYR_CONTENT_PORT=4002
ULTIMYR_QUIZ_PORT=4003
ULTIMYR_AI_PORT=4004
ULTIMYR_MCP_PORT=4005

# ---- Database ---------------------------------------------------------------
# Option A: bundled Postgres  ->  docker compose --profile bundled-db up -d
#   PG_HOST=postgres, PG_USER and PG_DATABASE below; password comes from secrets/pg_password.
# Option B: existing external Postgres (no profile needed). Either a full URL:
#   DATABASE_URL=postgres://user:password@db.example.com:5432/ultimyr
# or discrete parts (password still read from secrets/pg_password):
PG_HOST=postgres
PG_PORT=5432
PG_USER=ultimyr
PG_DATABASE=ultimyr
# disable | require | verify-full
PG_SSLMODE=disable

# ---- Public URL (needed for passkeys and SSO) ------------------------------
# The exact origin users type in the browser. Passkeys are bound to its hostname, so changing it later
# orphans registered passkeys. SSO callbacks are built from it.
ULTIMYR_PUBLIC_URL=http://localhost:3000
# Allow http:// identity providers (local testing only; never in production)
ULTIMYR_ALLOW_INSECURE_IDP=false

# ---- Auth --------------------------------------------------------------------
# open: anyone can register. closed: only the very first account (the admin) can.
AUTH_REGISTRATION=open
# Set true once you serve Ultimyr over HTTPS (NPM with SSL, or Traefik behind TLS)
COOKIE_SECURE=false
